# ==============================================================================
# MEETING INTELLIGENCE ASSISTANT - CẤU HÌNH BIẾN MÔI TRƯỜNG (.env)
# ==============================================================================
# Hướng dẫn: Sao chép tệp này thành .env để cấu hình:
#   Windows (PowerShell): copy .env.example .env
#   Linux / macOS:        cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH MÔ HÌNH NGÔN NGỮ LỚN (LLM API KEYS) - TÙY CHỌN
# ------------------------------------------------------------------------------
# Lưu ý: Hệ thống hỗ trợ ZERO-CONFIG OFFLINE FALLBACK.
# Nếu để trống cả OpenAI và Gemini API key, hệ thống sẽ tự động kích hoạt
# Heuristic Rule-Based Extractor, hoạt động 100% offline mà không cần API key.
# ------------------------------------------------------------------------------
# OpenAI API Key (Ví dụ: sk-proj-...)
OPENAI_API_KEY=

# Google Gemini API Key (Ví dụ: AIzaSy...)
GEMINI_API_KEY=

# Mô hình LLM mặc định sẽ sử dụng:
#   - Dành cho OpenAI: gpt-4o-mini, gpt-4o
#   - Dành cho Gemini: gemini-1.5-flash, gemini-1.5-pro
DEFAULT_LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH MÁY CHỦ BACKEND FASTAPI
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
PROJECT_NAME="Meeting Intelligence Assistant API"
VERSION="1.0.0"

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH CƠ SỞ DỮ LIỆU ĐỒ THỊ NEO4J / NEO4J AURADB CLOUD - TÙY CHỌN
# ------------------------------------------------------------------------------
# Mặc định hệ thống sử dụng thư viện NetworkX in-memory, hoàn toàn độc lập
# không bắt buộc phải cài đặt Neo4j để chạy toàn bộ tính năng đồ thị.
#
# Nếu muốn đồng bộ đồ thị lên đám mây (Neo4j AuraDB Free/Pro) hoặc Neo4j Docker:
# Điền thông tin kết nối dưới đây (khớp với tệp credentials tải từ console.neo4j.io):
# ------------------------------------------------------------------------------
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=your_instance_id_here
AURA_INSTANCENAME="Instance 1"
